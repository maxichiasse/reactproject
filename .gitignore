# ==============================
# 📦 DÉPENDANCES NODE
# ==============================
# Ignore tous les node_modules (frontend + backend)
**/node_modules/

# ==============================
# 🧾 LOGS
# ==============================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# 🔒 ENVIRONNEMENT & SECRETS
# ==============================
# Fichiers d'environnement (ne jamais commit)
.env
.env.*
*.env*
*.local
*.production

# ==============================
# 🏗️ FICHIERS DE BUILD / SORTIES
# ==============================
# Vite / TypeScript / Node / etc.
**/dist/
**/build/
**/.tsbuildinfo

# ==============================
# 🧰 ÉDITEURS ET FICHIERS LOCAUX
# ==============================
